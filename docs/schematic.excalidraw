0,"y":290,"text":"DS3231 RTC","fontSize":14,"fontFamily":1,"strokeColor":"#a78bfa","textAlign":"center","originalText":"DS3231 RTC","autoResize":true},{"type":"text","id":"x82","x":400,"y":308,"text":"\u00b12ppm \u00b7 CR2032 backup","fontSize":10,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"center","originalText":"\u00b12ppm \u00b7 CR2032 backup","autoResize":true},{"type":"text","id":"x83","x":400,"y":324,"text":"VCC \u00b7 GND \u00b7 SDA \u00b7 SCL","fontSize":10,"fontFamily":1,"strokeColor":"#64748b","textAlign":"center","originalText":"VCC \u00b7 GND \u00b7 SDA \u00b7 SCL","autoResize":true},{"type":"text","id":"x84","x":400,"y":344,"text":"I\u00b2C addr 0x68","fontSize":10,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"center","originalText":"I\u00b2C addr 0x68","autoResize":true},{"type":"text","id":"x85","x":400,"y":360,"text":"(separate from OLED addr)","fontSize":10,"fontFamily":1,"strokeColor":"#64748b","textAlign":"center","originalText":"(separate from OLED addr)","autoResize":true},{"type":"text","id":"x86","x":1300,"y":460,"text":"FEEDBACK","fontSize":12,"fontFamily":1,"strokeColor":"#22d3ee","textAlign":"left","originalText":"FEEDBACK","autoResize":true},{"type":"rectangle","id":"x87","x":1300,"y":480,"width":360,"height":140,"strokeColor":"#22d3ee","backgroundColor":"#0f172a","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"roundness":{"type":3}},{"type":"text","id":"x88","x":1480,"y":502,"text":"RGB LED \u00b7 common cathode","fontSize":14,"fontFamily":1,"strokeColor":"#22d3ee","textAlign":"center","originalText":"RGB LED \u00b7 common cathode","autoResize":true},{"type":"text","id":"x89","x":1480,"y":520,"text":"(or 3\u00d7 discrete LEDs)","fontSize":10,"fontFamily":1,"strokeColor":"#64748b","textAlign":"center","originalText":"(or 3\u00d7 discrete LEDs)","autoResize":true},{"type":"text","id":"x90","x":1320,"y":545,"text":"R \u2192 IO26","fontSize":11,"fontFamily":1,"strokeColor":"#fb7185","textAlign":"left","originalText":"R \u2192 IO26","autoResize":true},{"type":"text","id":"x91","x":1430,"y":545,"text":"G \u2192 IO27","fontSize":11,"fontFamily":1,"strokeColor":"#fb7185","textAlign":"left","originalText":"G \u2192 IO27","autoResize":true},{"type":"text","id":"x92","x":1540,"y":545,"text":"B \u2192 IO14","fontSize":11,"fontFamily":1,"strokeColor":"#fb7185","textAlign":"left","originalText":"B \u2192 IO14","autoResize":true},{"type":"text","id":"x93","x":1480,"y":565,"text":"\u2500 \u2192 GND","fontSize":11,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"left","originalText":"\u2500 \u2192 GND","autoResize":true},{"type":"text","id":"x94","x":1480,"y":590,"text":"Green=OK \u00b7 Amber=offline \u00b7 Red=error","fontSize":10,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"center","originalText":"Green=OK \u00b7 Amber=offline \u00b7 Red=error","autoResize":true},{"type":"rectangle","id":"x95","x":860,"y":690,"width":280,"height":100,"strokeColor":"#22d3ee","backgroundColor":"#0f172a","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"roundness":{"type":3}},{"type":"text","id":"x96","x":1000,"y":710,"text":"Piezo buzzer","fontSize":14,"fontFamily":1,"strokeColor":"#22d3ee","textAlign":"center","originalText":"Piezo buzzer","autoResize":true},{"type":"text","id":"x97","x":1000,"y":728,"text":"+ \u2192 IO25 \u00b7 \u2212 \u2192 GND","fontSize":11,"fontFamily":1,"strokeColor":"#fb7185","textAlign":"center","originalText":"+ \u2192 IO25 \u00b7 \u2212 \u2192 GND","autoResize":true},{"type":"text","id":"x98","x":1000,"y":745,"text":"Active \u00b7 3 kHz \u00b7 85 dB","fontSize":10,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"center","originalText":"Active \u00b7 3 kHz \u00b7 85 dB","autoResize":true},{"type":"text","id":"x99","x":1000,"y":762,"text":"Short beep = OK \u00b7 Long = error","fontSize":10,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"center","originalText":"Short beep = OK \u00b7 Long = error","autoResize":true},{"type":"text","id":"x100","x":1000,"y":778,"text":"(NPN transistor driver recommended)","fontSize":10,"fontFamily":1,"strokeColor":"#64748b","textAlign":"center","originalText":"(NPN transistor driver recommended)","autoResize":true},{"type":"rectangle","id":"x101","x":60,"y":410,"width":480,"height":280,"strokeColor":"#fbbf24","backgroundColor":"#0f172a","fillStyle":"solid","strokeWidth":1.5,"roughness":0,"opacity":100,"roundness":{"type":3}},{"type":"text","id":"x102","x":80,"y":430,"text":"CRITICAL NOTES","fontSize":14,"fontFamily":1,"strokeColor":"#fbbf24","textAlign":"left","originalText":"CRITICAL NOTES","autoResize":true},{"type":"text","id":"x103","x":80,"y":460,"text":"1. R307 UART is 5V. ESP32 GPIO is 3.3V. Voltage divider MANDATORY on R307 TX.","fontSize":11,"fontFamily":1,"strokeColor":"#fb7185","textAlign":"left","originalText":"1. R307 UART is 5V. ESP32 GPIO is 3.3V. Voltage divider MANDATORY on R307 TX.","autoResize":true},{"type":"text","id":"x104","x":80,"y":478,"text":"   Use 1k\u03a9 + 2k\u03a9 (or 1.8k\u03a9). ESP32 TX \u2192 R307 RX is fine, both 3.3V CMOS.","fontSize":11,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"left","originalText":"   Use 1k\u03a9 + 2k\u03a9 (or 1.8k\u03a9). ESP32 TX \u2192 R307 RX is fine, both 3.3V CMOS.","autoResize":true},{"type":"text","id":"x105","x":80,"y":504,"text":"2. R307 wants 5V VCC (not 3.3V). Wire to 5V rail, not LDO output.","fontSize":11,"fontFamily":1,"strokeColor":"#fb7185","textAlign":"left","originalText":"2. R307 wants 5V VCC (not 3.3V). Wire to 5V rail, not LDO output.","autoResize":true},{"type":"text","id":"x106","x":80,"y":522,"text":"   Genuine R307 needs 5V. Cheap clones often misbehave at 3.3V.","fontSize":11,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"left","originalText":"   Genuine R307 needs 5V. Cheap clones often misbehave at 3.3V.","autoResize":true},{"type":"text","id":"x107","x":80,"y":548,"text":"3. I\u00b2C pull-ups: 4.7k\u03a9 from SDA + SCL to 3.3V. Most OLEDs have these built in.","fontSize":11,"fontFamily":1,"strokeColor":"#fbbf24","textAlign":"left","originalText":"3. I\u00b2C pull-ups: 4.7k\u03a9 from SDA + SCL to 3.3V. Most OLEDs have these built in.","autoResize":true},{"type":"text","id":"x108","x":80,"y":566,"text":"   If RTC and OLED are on same bus and pull-ups conflict, desolder one set.","fontSize":11,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"left","originalText":"   If RTC and OLED are on same bus and pull-ups conflict, desolder one set.","autoResize":true},{"type":"text","id":"x109","x":80,"y":592,"text":"4. Watchdog timer: 30s. ESP32 resets if main loop hangs.","fontSize":11,"fontFamily":1,"strokeColor":"#fbbf24","textAlign":"left","originalText":"4. Watchdog timer: 30s. ESP32 resets if main loop hangs.","autoResize":true},{"type":"text","id":"x110","x":80,"y":610,"text":"5. Reset / BOOT buttons on ESP32-DevKit: use built-in or wire tactile.","fontSize":11,"fontFamily":1,"strokeColor":"#fbbf24","textAlign":"left","originalText":"5. Reset / BOOT buttons on ESP32-DevKit: use built-in or wire tactile.","autoResize":true},{"type":"text","id":"x111","x":80,"y":640,"text":"6. Decoupling caps: 100nF ceramic near each VCC pin of every IC.","fontSize":11,"fontFamily":1,"strokeColor":"#fbbf24","textAlign":"left","originalText":"6. Decoupling caps: 100nF ceramic near each VCC pin of every IC.","autoResize":true},{"type":"text","id":"x112","x":80,"y":658,"text":"7. Wire lengths < 15 cm for I\u00b2C. OLED and RTC sit close to ESP32.","fontSize":11,"fontFamily":1,"strokeColor":"#fbbf24","textAlign":"left","originalText":"7. Wire lengths < 15 cm for I\u00b2C. OLED and RTC sit close to ESP32.","autoResize":true},{"type":"line","id":"x113","x":180,"y":170,"width":100,"height":0,"points":[[0,0],[100,0]],"strokeColor":"#fbbf24","strokeWidth":2,"roughness":0,"opacity":100},{"type":"line","id":"x114","x":180,"y":290,"width":100,"height":0,"points":[[0,0],[100,0]],"strokeColor":"#34d399","strokeWidth":2,"roughness":0,"opacity":100},{"type":"line","id":"x115","x":1280,"y":220,"width":20,"height":-50,"points":[[0,0],[20,-50]],"strokeColor":"#fbbf24","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x116","x":1300,"y":220,"width":0,"height":-50,"points":[[0,0],[0,-50]],"strokeColor":"#fbbf24","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x117","x":400,"y":130,"width":0,"height":160,"points":[[0,0],[0,160]],"strokeColor":"#34d399","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x118","x":400,"y":130,"width":-120,"height":160,"points":[[0,0],[-120,160]],"strokeColor":"#34d399","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x119","x":520,"y":350,"width":120,"height":390,"points":[[0,0],[120,390]],"strokeColor":"#a78bfa","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x120","x":520,"y":360,"width":120,"height":350,"points":[[0,0],[120,350]],"strokeColor":"#a78bfa","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x121","x":520,"y":330,"width":120,"height":410,"points":[[0,0],[120,410]],"strokeColor":"#a78bfa","strokeWidth":1,"roughness":0,"opacity":100,"strokeStyle":"dashed"},{"type":"line","id":"x122","x":520,"y":340,"width":120,"height":370,"points":[[0,0],[120,370]],"strokeColor":"#a78bfa","strokeWidth":1,"roughness":0,"opacity":100,"strokeStyle":"dashed"},{"type":"line","id":"x123","x":1120,"y":530,"width":20,"height":210,"points":[[0,0],[20,210]],"strokeColor":"#fb7185","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x124","x":1120,"y":560,"width":180,"height":-15,"points":[[0,0],[180,-15]],"strokeColor":"#fb7185","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x125","x":1120,"y":590,"width":310,"height":-45,"points":[[0,0],[310,-45]],"strokeColor":"#fb7185","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x126","x":1120,"y":620,"width":420,"height":-75,"points":[[0,0],[420,-75]],"strokeColor":"#fb7185","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x127","x":640,"y":650,"width":660,"height":-340,"points":[[0,0],[660,-340]],"strokeColor":"#34d399","strokeWidth":1.5,"roughness":0,"opacity":100},{"type":"line","id":"x128","x":640,"y":620,"width":660,"height":-340,"points":[[0,0],[660,-340]],"strokeColor":"#fb7185","strokeWidth":2,"roughness":0,"opacity":100}],"appState":{"viewBackgroundColor":"#ffffff","gridSize":null}}