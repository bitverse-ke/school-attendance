f4444","strokeWidth":2,"roughness":0,"opacity":100},{"type":"line","id":"y877","x":830,"y":540,"width":-190,"height":0,"points":[[0,0],[-190,0]],"strokeColor":"#ef4444","strokeWidth":2,"roughness":0,"opacity":100},{"type":"line","id":"y878","x":1150,"y":520,"width":0,"height":-170,"points":[[0,0],[0,-170]],"strokeColor":"#22c55e","strokeWidth":2,"roughness":0,"opacity":100},{"type":"line","id":"y879","x":1150,"y":350,"width":-420,"height":0,"points":[[0,0],[-420,0]],"strokeColor":"#22c55e","strokeWidth":2,"roughness":0,"opacity":100},{"type":"line","id":"y880","x":730,"y":350,"width":-90,"height":0,"points":[[0,0],[-90,0]],"strokeColor":"#22c55e","strokeWidth":2,"roughness":0,"opacity":100},{"type":"text","id":"y881","x":60,"y":850,"text":"WIRE COLOR GUIDE (suggested)","fontSize":14,"fontFamily":1,"strokeColor":"#fbbf24","textAlign":"left","originalText":"WIRE COLOR GUIDE (suggested)","autoResize":true,"opacity":100},{"type":"text","id":"y882","x":60,"y":875,"text":"Red = +5V (R307) \u00b7 Blue/Pink = +3.3V \u00b7 Black = GND \u00b7 Yellow = I2C SDA \u00b7 Blue = I2C SCL \u00b7 Orange = LED \u00b7 Pink = Buzzer \u00b7 Grey = R307 TX \u00b7 Green = R307 RX","fontSize":11,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"left","originalText":"Red = +5V (R307) \u00b7 Blue/Pink = +3.3V \u00b7 Black = GND \u00b7 Yellow = I2C SDA \u00b7 Blue = I2C SCL \u00b7 Orange = LED \u00b7 Pink = Buzzer \u00b7 Grey = R307 TX \u00b7 Green = R307 RX","autoResize":true,"opacity":100},{"type":"text","id":"y883","x":60,"y":905,"text":"POWER FLOW:","fontSize":14,"fontFamily":1,"strokeColor":"#fbbf24","textAlign":"left","originalText":"POWER FLOW:","autoResize":true,"opacity":100},{"type":"text","id":"y884","x":60,"y":930,"text":"USB-C 5V -> AMS1117-3.3 -> 3.3V rail -> ESP32 + OLED + RTC + LED + Buzzer  \u00b7  R307 powered directly from 5V rail","fontSize":11,"fontFamily":1,"strokeColor":"#94a3b8","textAlign":"left","originalText":"USB-C 5V -> AMS1117-3.3 -> 3.3V rail -> ESP32 + OLED + RTC + LED + Buzzer  \u00b7  R307 powered directly from 5V rail","autoResize":true,"opacity":100},{"type":"text","id":"y885","x":60,"y":960,"text":"WATCH THE VOLTAGE DIVIDER:","fontSize":14,"fontFamily":1,"strokeColor":"#fb7185","textAlign":"left","originalText":"WATCH THE VOLTAGE DIVIDER:","autoResize":true,"opacity":100},{"type":"text","id":"y886","x":60,"y":985,"text":"R307 TX (5V) MUST go through the 1k + 2k divider before reaching ESP32 IO16. ESP32 GPIO is 3.3V tolerant only -- direct 5V damages it.","fontSize":11,"fontFamily":1,"strokeColor":"#fca5a5","textAlign":"left","originalText":"R307 TX (5V) MUST go through the 1k + 2k divider before reaching ESP32 IO16. ESP32 GPIO is 3.3V tolerant only -- direct 5V damages it.","autoResize":true,"opacity":100}],"appState":{"viewBackgroundColor":"#ffffff"}}